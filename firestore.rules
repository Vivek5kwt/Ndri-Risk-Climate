rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Each administrator can read only their own access record.
    match /admins/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    // Mobile submissions must keep working until the new mobile build with
    // anonymous sign-in is released. Survey data remains admin-only to read
    // or delete. Tighten writes to the authenticated user ID after release.
    match /surveySubmissions/{documentId} {
      allow get, list, delete: if isAdmin();
      allow create, update: if true;
    }
  }
}
